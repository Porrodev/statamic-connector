parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Statamic\\Contracts\\Auth\\User\:\:name\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/BlockingController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 4
			path: src/Http/BlockingController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Http/IpController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/Http/SiteHealthController.php

		-
			message: '#^Method Porro\\Statamic\\SiteHealthWidget\:\:html\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: src/SiteHealthWidget.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 1
			path: src/SiteHealthWidget.php

		-
			message: '#^Property Porro\\Statamic\\SiteHealthWidget\:\:\$handle has no type specified\.$#'
			identifier: missingType.property
			count: 1
			path: src/SiteHealthWidget.php

		-
			message: '#^Call to function method_exists\(\) with ''Statamic\\\\Updater\\\\UpdatesOverview'' and ''hasSecurityUpdate'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/StatamicHealth.php
