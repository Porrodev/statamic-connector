{
    "name": "porro/statamic-connector",
    "description": "Site health, suspicious activity and IP blocking for Statamic 5–6, in the control panel: security advisories, end-of-life PHP, Laravel and Statamic, updates and the scheduler, plus probes, failed logins and form floods, blocked in the app, at Cloudflare or in nginx. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev/?utm_source=statamic-connector&utm_medium=packagist&utm_campaign=connectors",
    "keywords": [
        "statamic",
        "statamic-addon",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "blocking",
        "firewall",
        "cloudflare",
        "porro"
    ],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "^0.3.5",
        "statamic/cms": "^5.0|^6.0",
        "porro/php-core": "^0.3.5"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Statamic\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Porro Site Health",
            "description": "Site health, suspicious activity and IP blocking in your control panel: advisories, end-of-life versions and updates, plus probes and failed logins, blocked in the app, at Cloudflare or in nginx. Free; connect Porro for uptime, SSL, domain and server checks too."
        },
        "laravel": {
            "providers": [
                "Porro\\Statamic\\StatamicConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Statamic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/statamic-connector/issues",
        "source": "https://github.com/Porrodev/statamic-connector",
        "docs": "https://github.com/Porrodev/statamic-connector#readme"
    },
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ]
}
