{
    "name": "porro/statamic-connector",
    "description": "Site health for Statamic: security advisories, end-of-life PHP, Laravel and Statamic versions, updates and the scheduler, in a control panel utility and dashboard widget. Free; connect Porro to add uptime, SSL, domain and server checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": [
        "statamic",
        "statamic-addon",
        "site health",
        "security",
        "advisories",
        "end of life",
        "updates",
        "monitoring",
        "porro"
    ],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "dev-main as 0.3.0",
        "statamic/cms": "^5.0|^6.0",
        "porro/php-core": "dev-main as 0.3.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Statamic\\": "src/"
        }
    },
    "extra": {
        "statamic": {
            "name": "Porro Site Health",
            "description": "Security advisories, end-of-life versions, updates and the scheduler, checked inside your site. Connect Porro for uptime, SSL, domain and server checks too."
        },
        "laravel": {
            "providers": [
                "Porro\\Statamic\\StatamicConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.18"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Statamic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/statamic-connector/issues",
        "source": "https://github.com/Porrodev/statamic-connector",
        "docs": "https://github.com/Porrodev/statamic-connector#readme"
    },
    "authors": [
        {
            "name": "Porro",
            "homepage": "https://porro.dev"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Porrodev/laravel-connector",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Porrodev/php-core",
            "no-api": true
        }
    ]
}
